/* pages/payment/payment.wxss */
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
  color: #333;
}

.order-info {
  padding-top: 10rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row .label {
  color: #666;
  font-size: 28rpx;
}

.info-row .value {
  color: #333;
  font-size: 28rpx;
}

.info-row.total {
  margin-top: 20rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #f0f0f0;
}

.info-row.total .label {
  font-size: 32rpx;
  font-weight: 600;
}

.info-row.total .value.price {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff4d4f;
}

/* 支付方式 */
.payment-methods {
  margin-top: 20rpx;
}

.method-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  transition: all 0.3s;
}

.method-item.active {
  border-color: #667eea;
  background: rgba(102, 126, 234, 0.05);
}

.method-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.method-icon-text {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  font-size: 40rpx;
  text-align: center;
  line-height: 48rpx;
}

.method-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.method-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #667eea;
  color: #fff;
  text-align: center;
  line-height: 40rpx;
  font-size: 24rpx;
}

/* 支付按钮 */
.payment-action {
  margin-top: 40rpx;
}

.btn-pay {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 12rpx;
  text-align: center;
  border: none;
}

.btn-pay.disabled {
  background: #ccc;
  color: #999;
}

.pay-tips {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}
