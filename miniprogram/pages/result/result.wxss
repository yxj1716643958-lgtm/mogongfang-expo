/* pages/result/result.wxss */
.result-wrapper {
  padding: 60rpx 0;
}

.result-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  color: #fff;
  margin: 0 auto 40rpx;
}

.success .result-icon {
  background: #52c41a;
}

.failed .result-icon {
  background: #ff4d4f;
}

.result-title {
  text-align: center;
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.result-desc {
  text-align: center;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 60rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row .label {
  color: #666;
  font-size: 28rpx;
}

.info-row .value {
  color: #333;
  font-size: 28rpx;
}

/* 票券列表 */
.tickets-section {
  margin-top: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.ticket-item {
  display: flex;
  align-items: center;
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.ticket-info {
  flex: 1;
}

.ticket-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.ticket-no {
  display: block;
  font-size: 24rpx;
  color: #999;
}

.ticket-qrcode {
  width: 100rpx;
  height: 100rpx;
}

.ticket-qrcode image {
  width: 100%;
  height: 100%;
}

/* 按钮 */
.btn-view, .btn-retry, .btn-back {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
  border: none;
}

.btn-view {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-retry {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.btn-back {
  background: #fff;
  color: #667eea;
  border: 2rpx solid #667eea;
}
