/* app.wxss */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', 'Helvetica Neue', sans-serif;
}

/* 通用容器 */
.container {
  padding: 20rpx;
}

/* 主要按钮 */
.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 12rpx;
  padding: 28rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
}

.btn-primary:active {
  opacity: 0.8;
}

.btn-primary.disabled {
  background: #ccc;
  box-shadow: none;
}

/* 次要按钮 */
.btn-secondary {
  background: #fff;
  color: #667eea;
  border: 2rpx solid #667eea;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 加载中 */
.loading {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
}

/* 错误提示 */
.error {
  text-align: center;
  padding: 60rpx 0;
  color: #ff4d4f;
}

/* 成功提示 */
.success {
  text-align: center;
  padding: 60rpx 0;
  color: #52c41a;
}
