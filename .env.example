# ============================================
# 微信支付配置文件
# ============================================
# 请复制此文件为 .env 并填入真实配置信息

# 服务器端口
SERVER_PORT=3000

# ============================================
# 微信支付商户配置
# ============================================

# 商户号 (在微信支付商户平台可查看)
WECHAT_MCHID=1234567890

# 应用ID (在微信公众平台或开放平台可查看)
WECHAT_APPID=wx1234567890abcdef

# API证书序列号 (在商户平台下载证书后查看)
WECHAT_SERIAL_NO=ABC123DEF456...

# APIv3密钥 (在商户平台设置)
WECHAT_API_V3_KEY=your_api_v3_key_32_characters

# ============================================
# 证书文件路径
# ============================================

# 商户API私钥 (从商户平台下载的私钥文件)
WECHAT_PRIVATE_KEY_PATH=./certs/apiclient_key.pem

# 商户API证书 (从商户平台下载的证书文件)
WECHAT_APICLIENT_CERT_PATH=./certs/apiclient_cert.pem

# ============================================
# 回调配置
# ============================================

# 支付结果通知回调地址 (必须是HTTPS)
# 注意: 需要配置公网可访问的HTTPS地址
WECHAT_NOTIFY_URL=https://your-domain.com/api/payment/notify

# ============================================
# 配置说明
# ============================================
#
# 1. 获取商户号和应用ID
#    - 登录微信支付商户平台: https://pay.weixin.qq.com/
#    - 商户号在账户中心可查看
#    - 应用ID在对应的微信公众平台/开放平台查看
#
# 2. 申请API证书
#    - 在商户平台 > 账户中心 > API安全 > 申请API证书
#    - 下载后解压得到:
#      • apiclient_cert.pem (证书文件)
#      • apiclient_key.pem (私钥文件)
#    - 将证书文件放在项目 certs/ 目录下
#
# 3. 获取证书序列号
#    - 在商户平台 > 账户中心 > API安全 > 查看证书序列号
#    - 或使用命令: openssl x509 -in apiclient_cert.pem -noout -serial
#
# 4. 设置APIv3密钥
#    - 在商户平台 > 账户中心 > API安全 > 设置APIv3密钥
#    - 密钥长度32位，由数字和大写字母组成
#
# 5. 配置回调地址
#    - 回调地址必须是HTTPS且可公网访问
#    - 本地测试可使用内网穿透工具 (如 ngrok, frp)
#
# ============================================
