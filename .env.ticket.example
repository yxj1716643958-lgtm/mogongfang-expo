# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ne_expo_ticket

# 服务器配置
SERVER_PORT=3001

# 二维码加密密钥（生产环境请修改为随机字符串，至少32位）
QR_SECRET_KEY=ne_expo_ticket_secret_key_2024_change_in_production

# ==================== 汇付天下配置 ====================
# 商户号和系统ID
HUIFU_MERCHANT_ID=
HUIFU_SYS_ID=

# 产品ID（应用ID）
HUIFU_APP_ID=

# 商户RSA私钥（Base64编码或PEM格式）
HUIFU_PRIVATE_KEY=

# 汇付RSA公钥（用于验签，Base64编码或PEM格式）
HUIFU_PUBLIC_KEY=

# 支付异步回调地址（必须是HTTPS，生产环境需要配置真实域名）
HUIFU_NOTIFY_URL=http://localhost:3001/api/v1/payments/huifu/notify

# 前端支付返回地址
HUIFU_RETURN_URL=http://localhost:8080/payment-result.html

# 汇付网关地址
# 生产环境: https://spin.cloudpnr.com
# 沙箱环境: https://hfgj.testpnr.com
HUIFU_GATEWAY_URL=https://spin.cloudpnr.com

# 环境设置：PRODUCTION（生产）/ SANDBOX（沙箱）
HUIFU_ENVIRONMENT=PRODUCTION
